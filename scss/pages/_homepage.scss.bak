                    }
                }
            }
        }
        .card-body {
            hr {
                margin: 2rem 0;
                &.first {
                    margin: 4rem 0 2rem; 
                }
            }
            p {
                font-size: 17px;
            }
            &.consult-partners {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }
        }
    }
    .pe-lg-4 {
        @include screen(md) {
            margin-bottom: 30px;
        }
    }
    .global-logo {
        display: flex;
        justify-content: center;
        margin: 25px 0;
    }
    .btn-primary {
        background: none;
        color: $bg-inner !important;
        border-color: $bg-inner;
    }
}

.compliance {
    .main-heading {
        color: #079ade;
        margin-bottom: 20px;
        text-align: left;
    }
    .certify-bg {
        background: #000139;
        padding: 70px 50px;
        position: relative;
        // @include css3-prefix(transform, translateY(50px));
        text-align: center;
        img {
            max-width: 500px;
        }
    }
    .award-bg {
        background: #01016a;
        padding: 70px 50px;
        .award-logo {
            display: flex;
            align-items: center;
            margin-bottom: 70px;
            img {
                width: 125px;
            }
            div:first-child {
                margin-right: 30px;
            }
            p {
                margin-bottom: 0;
                color: $white;
            }
        }
    }
}

.stay-section {
    padding: 7rem 0;
    @include image("pattern/dot-pattern.svg", $rep: no-repeat, $pos: right bottom);
    .stay-curve-swiper {
        padding-bottom: 50px;
        .swiper-wrapper {
            padding: 0 10px 20px;
        }
        .swiper-pagination {
            bottom: -5px;
        }
        .card-view {
           .card-view-body {
                min-height: 200px;
            p {
                font-size: 17px;
            }
           } 
        }
    }
}

.card-view {
    box-shadow: 0 3px 5px -4px rgba(0,0,3,0.2);
    border: 1px solid #e5e5e5;
    background: $white;
    position: relative;
    border-radius: 5px;
    transition: 150ms ease-in-out;
    transition-property: border, box-shadow;
    height: 100%;
    &:hover {
        box-shadow: 0 3px 15px -3px rgba(0,0,3,0.2);
        border: 1px solid #e9e9e9;  
    }
    .card-view-header {
        background: #f8f8f8;
        padding: 20px;
        .tags {
            display: inline-block;
            padding: 5px 15px;
            margin-bottom: 15px;
            border-radius: 3px;
            font-size: 16px;
            color: $white;
            &.white {
                background: linear-gradient(to right,#08a6f5 0%,#0775ee 100%);
            } 
            &.report {
                background: linear-gradient(to right,#8166fc 0%,#a03ff6 100%);
            } 
            &.guide {
                background: linear-gradient(to right,#ec8775 0%,#ec7590 100%);
            } 
        }
        h3 {
            margin-bottom: 15px;
            font-family: $rs-font-regular;
        }
    }
    .card-view-body {
        padding: 30px;
    }
}

.peer {
    background: #303354;
    padding: 15px 0;
    .col-md-2 {
      @include screen(custom, max, 768) {
        margin-bottom: 1rem;
      }
    }
    span {
        color: $white;
        font-size: 12px;
    }
}

.subscribe-footer{
    padding: 1rem 0;
    @include image("pattern/line-pattern.svg", $rep: repeat);
}

.subscribe {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    ul.subscribe-list {
        display: inline-block;
        padding: 0;
        li {
            display: flex;
            align-items: center;
            position: relative;
            label {
                margin-right: 5px;
            }
        }
    }
}

// Option 2
.home-video-banner {
    display: flex;
    align-items: center;
    height: 100vh;
}

@include screen(custom, max, 991) {
    .navbar-collapse {
        @include abs-position($p: fixed, $t: 85px, $l: 0px);
        width: 100%;
        background: $bg-color3;
        padding: 15px;
        max-width: 320px;
        height: 100vh;
        overflow-y: auto;
        @include css3-prefix(transition, left 0.3s ease-in);
        &.collapsing {
            height: 100vh;
            @include css3-prefix(transition, left 0.3s ease-in);
            left: -320px;
        }
        &.show {
            left: 0;
            @include css3-prefix(transition, left 0.3s ease-in);
        }
    }
    .header-links-container {
        justify-content: flex-start;
        align-items: flex-start;
    }
    .header-fixed .navbar-collapse {
        top: 70px;
    }
}

.back-to-top {
    background: $white;
    width: 0;
    height: 0;
    border-radius: 50px;
    overflow: hidden;
    color: transparent;
    visibility: hidden;
    display: block;
    border: none;
    @include abs-position($p: fixed, $b: 25px, $r: 25px);
    @include css3-prefix(transition, all .3s ease-in-out);
    outline: none;
    z-index: 99;
    &:after {
        content: "";
        display: block;
        vertical-align: middle;
        border-bottom: 10px solid $heading-color1;
        border-left: 10px solid transparent;
        line-height: 0;
        border-right: 10px solid transparent;
        border-bottom-color: $white;
        position: relative;
        top: -12px;
        height: 0;
        margin: 5px auto 0;
        width: 0;
        border-radius: 20px;
        visibility: hidden;  
    }
    &:before {
        content: "";
        display: block;
        vertical-align: middle;
        border-bottom: 10px solid $heading-color1;
        border-left: 10px solid transparent;
        line-height: 0;
        border-right: 10px solid transparent;
        height: 0;
        margin: 13px auto 0;
        width: 0;
        border-radius: 20px;
        visibility: hidden;  
    }
    &.show {
        width: 40px;
        height: 40px;
        visibility: visible;
        display: block;
        background: $white;
        @include abs-position($p: fixed, $b: 20px, $r: 25px);
        box-shadow: 0px 2px 4px 1px rgba(0, 0, 0, 0.25);
        &:after {
            visibility: visible;
        }
        &:before {
            visibility: visible;
        }
        &:active {
            box-shadow: 0px 4px 8px 2px rgba(0, 0, 0, 0.25);
        }
    }
    &.hide {
        visibility: hidden;
        opacity: 0;
    }
}

// HEADER ANIMATE
body.scroll-enabled .header-links-container .header-links {
    transform: translateY(-60px);
    @include screen(custom, max, 991) {
        transform: translateY(0);
    }
}
body.scroll-enabled .header-links-container .header-links {
    position: relative;
}
body .navigation,
body ul.navbar-nav,
body .navigation.white-theme .navbar-brand,
body .header-links-container .header-links,
body .navbar-collapse
 {
    transition: 0.3s all ease;
}
body .navigation.white-theme .navbar-brand {
    background-position: left center;
    background-size: 100%;
}
body.scroll-enabled .navigation.white-theme .navbar-brand {
    width: 290px;
}
body .navigation {
    height: 105px;
    @include screen(md) {
        height: 85px;
    }
}
body.scroll-enabled .navigation {
    height: 70px;
}
body ul.navbar-nav {
    transform: translateY(0);
}
body.scroll-enabled ul.navbar-nav {
    transform: translateY(-20px);
    @include screen(custom, max, 991) {
        transform: translateY(0);
    }
}

.mobile-bg {
    &:before {
        position: fixed;
        content: '';
        background: #00000060;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 22;
    }
}

.header-links-container {
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: end;
    width: 100%;
    .header-links {
        display: flex;
        justify-content: end;
        margin: 10px 0;
        @include screen(md) {
            border-bottom: 1px solid $bg-color5;
            padding-bottom: 30px;
        }
        li {
            margin-right: 15px;
            a {
                color: $white;
                font-size: 15px;
            }
            &:last-child {
                margin-right: 0;
            }
            &:nth-child(2) {
                a {
                    background: $bg-color6;
                    padding: 7px 12px;
                    border-radius: 5px;
                    text-transform: uppercase;
                }
            }
        }
    }
}

.navigation {
    padding: 20px 0;
    .navbar-brand {
        @include image("logos/resulticks-logo-white.svg", $rep: no-repeat);
        background-size: cover;
        width: 345px;
        height: 55px;
    }
    .navbar-toggler.navbar-icon {
        border: none;
        &:focus {
            outline: none;
        }
        &[aria-expanded="true"] {
            .icon-bar {
                &:nth-of-type(1) {
                    @include css3-prefix(transform, rotate(45deg));
                    @include css3-prefix(transform-origin, 10% 10%);
                }
                &:nth-of-type(2) {
                    opacity: 0;
                    filter: alpha(opacity=0);
                }
                &:nth-of-type(3) {
                    @include css3-prefix(transform, rotate(-45deg));
                    @include css3-prefix(transform-origin, 10% 90%);
                }
            }
        }
        .icon-bar {
            width: 27px;
            display: block;
            height: 3px;
            background-color: $heading-color1;
            @include css3-prefix(transition, all .3s);
            position: relative;
            top: 5px;
            &+ .icon-bar {
                margin-top: 4px;
            }
            &:nth-of-type(1) {
                @include css3-prefix(transform, rotate(0));
            }
            &:nth-of-type(2) {
                opacity: 1;
                filter: alpha(opacity=100);
            }
            &:nth-of-type(3) {
                @include css3-prefix(transform, rotate(0));
            }
        }
    }
    .navbar-nav {
        background: rgba(0,0,0,0.2);
        @extend %pipe-line;
        .nav-item {
            margin: 0 25px;
            @include screen(md) {
                margin: 0;
            }
            &:before {
                border-color: $white;
                left: -27px;
                top: 16px;
                height: 15px;
            }
            &:last-child {
                margin-right: 7px;
            }
            .nav-link {
                color: $white;
                padding: 10px 0;
                font-family: $rs-font-medium;
                font-size: 18px;
                position: relative;
                cursor: pointer;
                &:before {
                    @include position-inherit($p: absolute, $b: 4px, $r: 0);
                    width: 0%;
                    height: 2px;
                    background: $white;
                    @include css3-prefix(transition, all 0.3s ease-out);
                }
                &:after {
                    border-top: 7px solid;
                    border-right: 7px solid transparent;
                    border-left: 7px solid transparent;
                    position: relative;
                    top: 2px;
                    right: -5px;
                }
                &:hover {
                    &:before {
                        left: 0;
                        width: 100%;
                    }
                }
            }
            .dropdown-menu {
                opacity: 0;
                visibility: hidden;
                @include css3-prefix(transition, all 0.3s);
                margin-top: 0;
                display: block;
                padding: 0;
                border-radius: 0;
                &.dropdown-menu-end {
                    right: 0;
                    left: auto;
                }
                li {
                    &:before {
                        content: inherit;
                        border-left: 0;
                    }
                    .dropdown-item {
                        padding: 10px 12px;
                        @include css3-prefix(transition, all 0.3s);
                        &:hover {
                            padding-left: 15px;
                            border-left: 5px solid $heading-color2;
                        }
                    }
                }
                &.dropdown-fade-up {
                    top: 180%;
                }
            }
            &:hover {
                .dropdown-menu {
                    opacity: 1;
                    visibility: visible;
                    top: 100%;
                    @include css3-prefix(transform, rotateX(0deg));
                    @include css3-prefix(transition, all 0.3s);
                    margin-top: 0;
                }
            }
        }
    }
    &.header-fixed {
        background: $white;
        box-shadow: 0 -1px 3px 0 #000;
        position: fixed;
        width: 100%;
        z-index: 999;
        padding: 10px 0;
        .navbar-brand {
            @include image("logos/resulticks-logo-blue.svg", $rep: no-repeat);
            background-size: cover;
            width: 345px;
            height: 55px;
        }

        .navbar-nav {
            background: none;
            .nav-item {
                &:last-child {
                    margin-right: 5px;
                }
                &:before {
                    border-color: $black-medium;
                }
                .nav-link {
                    color: $black-medium;
                    &:before {
                        background: $black-medium;
                    }
                }
            }
        }

        .header-links-container {
            .header-links {
                li {
                    a {
                        color: $body-text;
                    }
                    &:nth-child(2) {
                        a {
                            color: $white;
                        }
                    }
                }
            }
        }     
    }
    &.white-theme {
        padding: 5px 0;
        background: $white;
        .navbar-brand {
            @include image("logos/resulticks-logo-blue.svg", $rep: no-repeat);
            background-size: cover;
            width: 345px;
            height: 55px;
            @include screen(md) {
                width: 225px;
                background-size: 100%;
                background-position: left center;
            }
            @include screen(custom, min, 1441) {
                width: 415px;
                height: 65px;
            }
        }
        .navbar-nav {
            background: none;
            .nav-item {
                &:before {
                    border-color: $black-medium;
                }
                .nav-link {
                    color: $black-medium;
                    &:before {
                        background: $black-medium;
                    }
                }
            }
        }
        .header-links {
            li {
                a {
                    color: $body-text;
                }
                &:nth-child(2) {
                    a {
                        color: $white;
                        font-family: $rs-font-medium;
                    }
                }
            }
        }    
    }
}

.home-video-banner {
    position: relative;
    .container-fluid {
        width: 100%;
    }
    .redefine {
        font-family: $rs-font-sbold;
        margin-bottom: 0;
        font-size: 45px;
        line-height: 1.25;
        display: block;
        // -webkit-animation-duration: 1s;
        // animation-duration: 1s;
        // -webkit-animation-fill-mode: both;
        // animation-fill-mode: both;
        // animation-name: fadeInDown;
        // animation-delay: 0.5s;
        @include screen(custom, min, 1441) {
            font-size: 60px;
        }
        @include screen(md) {
            font-size: 27px;
        }
        &:first-child {
            @include screen(md) {
                padding-top: 25px;
            }
        }
    }
    h1 {
        // -webkit-animation-duration: 1s;
        // animation-duration: 1s;
        // -webkit-animation-fill-mode: both;
        // animation-fill-mode: both;
        // animation-name: fadeInDown;
        // animation-delay: 0.7s;
        font-size: 45px;
        font-family: $rs-font-sbold;
        @include screen(custom, min, 1441) {
            font-size: 60px;
        }
        @include screen(md) {
            font-size: 27px;
            margin-bottom: 15px;
        }
    }
    h3 {
        // -webkit-animation-duration: 1s;
        // animation-duration: 1s;
        // -webkit-animation-fill-mode: both;
        // animation-fill-mode: both;
        // animation-name: fadeInDown;
        // animation-delay: 1s;
        font-family: $rs-font-regular;
        font-size: 33px;
        @include screen(custom, min, 1441) {
            font-size: 41px;
        }
        @include screen(md) {
            font-size: 21px;
            margin-bottom: 15px;
        }
    }
    video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .btn-arrow {
        font-size: 21px;
        @include screen(custom, min, 1199) {
            font-size: 19px;
        }
        @include screen(md) {
            font-size: 15px;
            padding: 10px 25px;
        }
    }
}

.home-video {
    position: relative;
    .video-text {
        @include abs-position($p: absolute, $l: 50px, $t: 25%);
        .redefine {
            font-family: $rs-font-sbold;
            color: $white;
            margin-bottom: 0;
            font-size: 66px;
            line-height: 75px;
            display: block;
            text-shadow: 0 2px 3px #333;
            -webkit-animation-duration: 1s;
            animation-duration: 1s;
            -webkit-animation-fill-mode: both;
            animation-fill-mode: both;
            animation-name: fadeInDown;
            animation-delay: 0.5s;
        }
        h1 {
            color: $white;
            -webkit-animation-duration: 1s;
            animation-duration: 1s;
            -webkit-animation-fill-mode: both;
            animation-fill-mode: both;
            animation-name: fadeInDown;
            animation-delay: 0.7s;
            font-size: 66px;
            text-shadow: 0 2px 3px #333;
            font-family: $rs-font-sbold;
        }
        h3 {
            color: #95f1ff;
            -webkit-animation-duration: 1s;
            animation-duration: 1s;
            -webkit-animation-fill-mode: both;
            animation-fill-mode: both;
            animation-name: fadeInDown;
            animation-delay: 1s;
            font-family: $rs-font-medium;
            width: 58%;
            line-height: 55px;
            font-size: 37px;
            text-shadow: 0 2px 3px #333;
          }
    }
}

.home-banner-swiper {
    .container {
        max-width: 85%;
        margin-top: 35px;
        @include screen(md) {
            max-width: 95%;
            height: 100vh;
        }
        img {
            &.img-fluid {
                @include screen(md) {
                    max-width: 300px;
                }
            }
        }
    }
    width: 100%;
    .swiper-slide {
        @include flex($dir: column);
        height: 100vh;
        background-color: #fff;
        &:nth-child(2) {
            // @include image("banner/home-banner2.jpg", $rep: no-repeat, $pos: center center,);
            background-size: cover;
        }
        &:nth-child(3) {
            // @include image("banner/home-banner3.jpg", $rep: no-repeat, $pos: center center,);
            background-size: cover;
        }
        .banner-heading {
            font-size: 50px;
            font-family: $rs-font-sbold;
            margin-bottom: 25px;
            line-height: 1.25;
            display: block;
            @include screen(custom, min, 1441) {
                font-size: 60px;
            }
            @include screen(md) {
                font-size: 27px;
                padding-top: 25px;
                margin-bottom: 10px;
            }
            .resul-logo {
                position: relative;
                top: -4px;
                img {
                    height: 45px;
                    @include screen(custom, min, 1441) {
                        font-size: 53px;
                    }
                }
            }
            .rs-font-bold.resul-text {
                font-family: "Arial-Black";
                font-size: 50px;
                letter-spacing: -0.8px;
                color: $resul-text;
                font-weight: 900;
                -webkit-text-stroke-width: 2px;
                -webkit-text-stroke-color: $resul-text;
            }
        }
        h2 {
            font-family: $rs-font-regular;
            @include screen(custom, min, 1441) {
                font-size: 41px;
            }
            @include screen(md) {
                font-size: 21px;
            }
        }
        .banner-info {
            @include css3-prefix(transition, all 0.3s ease);
            // @include css3-prefix(transform, scale(1));
            // opacity: 0;
            // transition-delay: 1.3s;
            // transition-duration: 1.5s;
        }
        &.swiper-slide-active {
            .banner-info {
                // opacity: 1;
                // @include css3-prefix(transform, scale(1));
            }
        }
    }
    .video-bar {
        position: relative;
        top: 10px;
        width: 100%;
        overflow: hidden;
        // max-width: 600px;
        // @include screen(custom, min, 1441) {
        //     max-width: 750px;
        // }
        @include screen(md) {
            max-width: 375px;
            margin-top: 60px;
        }
        video {
          // transform: scale(1);
        }
        &.real-time-video {
            transform: scale(1.2) translateX(30px);
            @include screen(custom, min, 1441) {
                transform: scale(1.35) translateX(30px);
            }
            @include screen (md) {
                transform: scale(1) translateX(10px);
            }
        }
    }
    .swiper-pagination-bullet {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        opacity: 1;
        background: transparent;
        border: 1px solid $tick-color;
        transition: ease 0.5s;
    }
    .swiper-pagination-bullet-active {
        width: 45px;
        height: 11px;
        border-radius: 15px;
        background: $tick-color;
    }
    .swiper-button-next, .swiper-button-prev { 
        width: 50px !important;
        height: 50px !important;
        background-size: 50px;
    }
    .swiper-button-next, .swiper-rtl .swiper-button-prev {
        right: -50px;
        transition: 0.3s all ease;
    }
    .swiper-button-prev, .swiper-rtl .swiper-button-next {
        left: -50px;
        transition: 0.3s all ease;
    }
    .swiper-button-next.swiper-button-disabled, 
    .swiper-button-prev.swiper-button-disabled {
        filter: grayscale(1)
    }
    &:hover {
        .swiper-button-next, .swiper-rtl .swiper-button-prev {
            right: 35px;
        }
        .swiper-button-prev, .swiper-rtl .swiper-button-next {
            left: 35px;
        }
    }
}

.growth-section {
    .bg-light-blue {
        border-radius: 5px;
        border: 1px solid #0018f9;
    }
    .container {
        padding: 3rem;
        @include screen(custom, min, 1199) {
            padding: 3rem 5rem;
        }
        p {
            font-size: 25px;
            @include screen(custom, min, 1199) {
                font-size: 23px;
            }
            @include screen(md) {
                font-size: 17px;
            }
        }
    }
}

.global-brands {
    padding: 5rem 50px;
    h2 {
        font-size: 2.5rem;
        color: $heading-color2;
    }
    .total {
        font-size: 2.5rem;
        font-family: $rs-font-medium;
        line-height: 33px;
        margin-bottom: 10px;
        .volume {
            font-size: 1.5rem;
            font-family: $rs-font-light; 
        }
    }
    .grid-divider {
        position: relative;
        & > [class*="col-"] {
            position: relative;
            &:nth-child(n + 2):after {
                left: 2px;
            }
        }    
    }
    p {
        margin-bottom: 1.5rem;
        font-size: 17px;
    }
    .global-icons {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        img {
            max-width: 100px;
        }
    }
}

.choose-brand {
    padding: 5rem 50px;
    @include screen(md) {
        padding: 3rem 25px;
    }
    background: #f8f8f8;
    .card-bg {
        display: flex;
        align-items: stretch;
        padding-right: 1.5rem;
        @include screen(md) {
            padding-right: 0;
        }
        .card {
            border: 1px solid #e5e5e5;
            border-radius: 5px;
            &:hover {
                box-shadow: 0 3px 9px -3px rgba(0, 0, 3, 0.3);
            }
            @include screen(md) {
                margin-bottom: 25px;
            }
        }
        .card-header {
            background: $white;
            padding: 1rem 1rem 0;
            border-bottom: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            .logo-img {
                height: 43px;
            }
        }
        .card-body {
            padding: 2rem 2rem 2.25rem;
            p {
                font-size: 17px;
                line-height: 1.5;
            }
        }
    }
}

.partner-swiper-container {
    .home-partner-swiper {
        // margin-bottom: 50px;
        .partners-logo {
            height: 120px;
            background: $white;
            border-radius: 5px;
            padding: 15px;
            margin: 25px 0;
            // box-shadow: 0 1px 3px 2px #e1e1e1;
            display: flex;
            align-items: center;
            justify-content: center;
            img {
                max-width: 175px;
                max-height: 120px;
            }
        }
    }
}

.our-clients {
    @include image("home/client-bg.jpg", $rep: no-repeat, $pos: center);
    background-size: cover;
    .swiper-button-position.horizontal.bottom {
        bottom: -25px;
    }
    .client-bg {
        background: #ffffff20;
        border: 1px solid #2d2d85;
        border-radius: 5px;
        padding: 50px 50px 30px;
        margin-bottom: 30px;
        position: relative;
        p {
            font-size: 17px;
            color: $white;
        }
    }
    .client-logo {
        display: flex;
        align-items: center;
        background: $white;
        padding: 15px;
        border-radius: 5px;
        @include screen (md) {
            flex-direction: column;
            text-align: center;
        }
        div {
            &:first-child {
                position: relative;
                margin-right: 40px;
                @include screen (md) {
                    margin: 0;
                }
                &:after {
                    @include position-inherit($p: absolute, $r: -20px, $t: 50%);
                    width: 2px;
                    height: 75px;
                    background: #ccc;
                    @include css3-prefix(transform, translateY(-50%));
                    @include screen (md) {
                        display: none;
                    }
                }
            }
        }
        .logo-info {
            width: 125px;
        }
        h3 {
            margin-bottom: 0px;
        }
        p {
            color: $body-text;
            margin-bottom: 0;
            font-style: italic;
        }
    }
    .quote-top {
        @include abs-position($p: absolute, $l: 100px, $t: -30px);
        z-index: 1;
        @include screen (md) {
            left: 30px;
        }
        img {
            width: 90px;
        }
    }
    .quote-bottom {
        @include abs-position($p: absolute, $r: 120px, $b: 10px);
        z-index: 1;
    }
}

.key-partners {
    padding: 5rem 50px;
    @include screen (md) {
        padding: 3rem 20px;
    }
    .card {
        height: 100%;
        border: 0;
        box-shadow: 0 0 3px 2px #e1e1e1;
        .card-bg {
            @include flex($dir: column);
            text-align: center;
            padding: 15px;
            min-height: 250px;
            background: $key-partner-bg;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;
            // &.first {
            //     background: linear-gradient(to right,#08a6f5 0%,#0775ee 100%);
            // } 
            // &.second {
            //     background: linear-gradient(to right,#8166fc 0%,#a03ff6 100%);
            // } 
            // &.third {
            //     background: linear-gradient(to right,#ec8775 0%,#ec7590 100%);
            // } 
            img {
                margin-bottom: 15px;
            } 
            p {
                font-size: 17px;
                color: $white;
            }
        }
        
        .consult-logo {
            display: flex;
            justify-content: center;
            img {
                width: 150px;
            }
            div {
                &:first-child {
                    padding-right: 20px;
                    border-right: 1px solid #ccc;
                    border-bottom: 1px solid #ccc;
                    min-height: 125px;
                    display: flex;
                    align-items: center; 
                }
                &:nth-child(2) {
                    padding-left: 20px;
                    border-bottom: 1px solid #ccc;
                    min-height: 125px;
                    display: flex;
                    align-items: center;
                }
            }
            &:last-child {
                div {
                    &:first-child, &:nth-child(2) {
